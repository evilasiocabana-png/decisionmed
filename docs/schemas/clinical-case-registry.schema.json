{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionmed.local/schemas/clinical-case-registry.schema.json",
  "title": "DecisionMEd Clinical Case Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "const": "11.0.0" },
    "items": {
      "type": "array",
      "minItems": 4500,
      "maxItems": 4500,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "textArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "values", "detail"],
      "properties": {
        "fact_id": { "$ref": "#/$defs/identifier" },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 8000 }
        },
        "detail": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "event_type", "payload"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_type": { "$ref": "#/$defs/identifier" },
        "payload": { "type": "string", "minLength": 2, "maxLength": 8000 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "module_id",
        "ordinal",
        "category",
        "narrative",
        "selected_answers",
        "positive_details",
        "expected_route_module_ids",
        "obtained_route_module_ids",
        "opened_question_ids",
        "initial_classification",
        "differentials",
        "physical_examination",
        "complementary_exams",
        "post_exam_result",
        "expected_impression",
        "audit_events",
        "audit_hash"
      ],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "module_id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 15 },
        "category": {
          "enum": [
            "typical",
            "atypical",
            "red_flag",
            "mimic",
            "comorbidity",
            "contradictory",
            "post_exam"
          ]
        },
        "narrative": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "selected_answers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/answer" }
        },
        "positive_details": { "$ref": "#/$defs/textArray" },
        "expected_route_module_ids": {
          "allOf": [
            { "$ref": "#/$defs/identifierArray" },
            { "minItems": 1 }
          ]
        },
        "obtained_route_module_ids": { "$ref": "#/$defs/identifierArray" },
        "opened_question_ids": { "$ref": "#/$defs/identifierArray" },
        "initial_classification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "differentials": { "$ref": "#/$defs/textArray" },
        "physical_examination": { "$ref": "#/$defs/textArray" },
        "complementary_exams": { "$ref": "#/$defs/textArray" },
        "post_exam_result": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4000
        },
        "expected_impression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "audit_events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "audit_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
