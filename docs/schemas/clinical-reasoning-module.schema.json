{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionmed.local/schemas/clinical-reasoning-module.schema.json",
  "title": "DecisionMEd Clinical Reasoning Module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "specialty",
    "definition",
    "pathophysiology",
    "ontology",
    "manifestations",
    "red_flags",
    "differential_diagnoses",
    "diagnostic_criteria",
    "exams",
    "treatment",
    "scales",
    "guidelines",
    "evidence",
    "question_engine",
    "decision_engine",
    "follow_up_engine",
    "governance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "specialty": {
      "type": "string",
      "minLength": 2
    },
    "definition": {
      "type": "string",
      "minLength": 10
    },
    "pathophysiology": {
      "type": "string",
      "minLength": 10
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestations",
        "phenotypes",
        "entity_type",
        "entity_name"
      ],
      "properties": {
        "manifestations": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "phenotypes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true
        },
        "entity_type": {
          "enum": [
            "initial_syndrome",
            "standardized_entity",
            "clinical_presentation"
          ]
        },
        "entity_name": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "manifestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "frequent"],
      "properties": {
        "required": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "frequent": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        }
      }
    },
    "red_flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "differential_diagnoses": {
      "type": "array",
      "items": { "$ref": "#/$defs/hypothesis" },
      "minItems": 1
    },
    "diagnostic_criteria": {
      "type": "array",
      "items": { "$ref": "#/$defs/criterion" }
    },
    "exams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["indicated", "not_routinely_indicated"],
      "properties": {
        "indicated": {
          "type": "array",
          "items": { "$ref": "#/$defs/exam" }
        },
        "not_routinely_indicated": {
          "type": "array",
          "items": { "$ref": "#/$defs/exam" }
        }
      }
    },
    "treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "definitive"],
      "properties": {
        "initial": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "definitive": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "scales": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "guidelines": {
      "type": "array",
      "items": { "$ref": "#/$defs/reference" },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "minItems": 1
    },
    "question_engine": {
      "$ref": "#/$defs/engine"
    },
    "decision_engine": {
      "$ref": "#/$defs/engine"
    },
    "follow_up_engine": {
      "$ref": "#/$defs/engine"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewed_by", "reviewed_at", "review_due_at"],
      "properties": {
        "status": {
          "enum": ["draft", "in_review", "validated", "retired"]
        },
        "reviewed_by": {
          "type": ["string", "null"]
        },
        "reviewed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "review_due_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "rationale"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 3 },
        "rationale": { "type": "string", "minLength": 5 }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "discriminators"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 3 },
        "group": {
          "enum": ["more_likely", "cannot_miss", "mimic"]
        },
        "discriminators": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "clinical_question"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 2 },
        "clinical_question": { "type": "string", "minLength": 5 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "requires_professional_confirmation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 3 },
        "requires_professional_confirmation": { "const": true }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "year", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 3 },
        "publisher": { "type": "string", "minLength": 2 },
        "year": { "type": "integer", "minimum": 1900 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "level", "supports"],
      "properties": {
        "reference_id": { "type": "string", "minLength": 1 },
        "level": { "type": "string", "minLength": 1 },
        "supports": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "rules"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "rules": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
