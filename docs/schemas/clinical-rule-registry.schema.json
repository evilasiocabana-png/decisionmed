{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionmed.local/schemas/clinical-rule-registry.schema.json",
  "title": "DecisionMEd Clinical Rule Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": { "enum": ["9.0.0", "10.0.0", "11.0.0"] },
    "items": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "operator", "value"],
          "properties": {
            "fact": { "$ref": "#/$defs/identifier" },
            "operator": { "enum": ["equals", "contains"] },
            "value": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "operator", "values"],
          "properties": {
            "fact": { "$ref": "#/$defs/identifier" },
            "operator": { "enum": ["contains_any", "contains_all"] },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "operator", "values", "threshold"],
          "properties": {
            "fact": { "$ref": "#/$defs/identifier" },
            "operator": { "const": "count_at_least" },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 500 }
            },
            "threshold": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "operator", "pattern"],
          "properties": {
            "fact": { "$ref": "#/$defs/identifier" },
            "operator": { "const": "matches" },
            "pattern": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fact", "operator"],
          "properties": {
            "fact": { "$ref": "#/$defs/identifier" },
            "operator": { "const": "present" }
          }
        }
      ]
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/predicate" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            },
            "any": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            },
            "none": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "module_id",
        "version",
        "effect",
        "strength",
        "rationale",
        "when",
        "output_key",
        "priority",
        "source_ids",
        "status",
        "reviewed_on",
        "reviewed_by",
        "review_due_on"
      ],
      "properties": {
        "rule_id": { "$ref": "#/$defs/identifier" },
        "module_id": { "$ref": "#/$defs/identifier" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "effect": { "enum": ["support", "oppose", "alarm", "route"] },
        "strength": { "enum": ["low", "moderate", "high", "critical"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "when": { "$ref": "#/$defs/condition" },
        "output_key": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "output_value": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 1000
        },
        "priority": { "type": "boolean" },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "status": {
          "enum": ["draft", "in_review", "validated", "retired"]
        },
        "reviewed_on": { "type": ["string", "null"], "format": "date" },
        "reviewed_by": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "review_due_on": { "type": ["string", "null"], "format": "date" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "effect": { "const": "route" } },
            "required": ["effect"]
          },
          "then": {
            "properties": {
              "output_key": { "$ref": "#/$defs/identifier" },
              "output_value": { "type": "null" }
            }
          },
          "else": {
            "required": ["output_value"],
            "properties": {
              "output_key": { "type": "null" },
              "output_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "validated" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "source_ids": { "minItems": 1 },
              "reviewed_on": { "type": "string", "format": "date" },
              "reviewed_by": { "$ref": "#/$defs/identifier" },
              "review_due_on": { "type": "string", "format": "date" }
            }
          }
        }
      ]
    }
  }
}
